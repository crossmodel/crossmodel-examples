entity:
  id: crm_cust
  name: "CRM_CUST"
  description: "Core customer profile table in the CRM system"
  attributes:
  - id: cust_id
    name: "CUST_ID"
    description: "Unique customer identifier"
    datatype: "Integer"
    mandatory: true
  - id: fname
    name: "FNAME"
    description: "First name"
    datatype: "Text"
    length: 80
  - id: lname
    name: "LNAME"
    description: "Last name"
    datatype: "Text"
    length: 80
  - id: email_addr
    name: "EMAIL_ADDR"
    description: "Primary email"
    datatype: "Text"
    length: 240
  - id: dob
    name: "DOB"
    description: "Date of birth"
    datatype: "Date"
  - id: reg_dt
    name: "REG_DT"
    description: "Registration timestamp"
    datatype: "DateTime"
  identifiers:
  - id: pk_crm_cust
    name: "PK_CRM_CUST"
    primary: true
    attributes:
    - cust_id
