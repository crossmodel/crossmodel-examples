entity:
  id: importConfigs
  name: "Import Configurations"
  description: "Configuration settings for data imports"
  attributes:
    - id: ^id
      name: "ID"
      datatype: "Integer"
    - id: ^identifier
      name: "Identifier"
      datatype: "Text"
      length: 250
    - id: ^name
      name: "Name"
      datatype: "Text"
    - id: ^type
      name: "Type"
      datatype: "Integer"
    - id: ^mappings
      name: "Mappings"
      datatype: "Text"
    - id: filedata
      name: "File Data"
      datatype: "Text"
    - id: config
      name: "Configuration"
      datatype: "Text"
    - id: tenantId
      name: "Tenant ID"
      datatype: "Text"
      length: 50
    - id: createdBy
      name: "Created By"
      datatype: "Text"
      length: 250
    - id: updatedBy
      name: "Updated By"
      datatype: "Text"
      length: 250
    - id: createdAt
      name: "Created At"
      datatype: "DateTime"
    - id: updatedAt
      name: "Updated At"
      datatype: "DateTime"
    - id: deletedAt
      name: "Deleted At"
      datatype: "DateTime"
  identifiers:
    - id: importConfigsPrimaryKey
      name: "Import Configurations Primary Key"
      primary: true
      attributes:
        - ^id