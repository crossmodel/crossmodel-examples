entity:
  id: collections
  name: "Collections"
  description: "User-defined collections of items"
  attributes:
    - id: ^id
      name: "ID"
      datatype: "Integer"
    - id: ^identifier
      name: "Identifier"
      datatype: "Text"
      length: 250
    - id: ^name
      name: "Name"
      datatype: "Text"
    - id: public
      name: "Public"
      datatype: "Boolean"
    - id: user
      name: "User"
      datatype: "Text"
      length: 250
    - id: tenantId
      name: "Tenant ID"
      datatype: "Text"
      length: 50
    - id: createdBy
      name: "Created By"
      datatype: "Text"
      length: 250
    - id: updatedBy
      name: "Updated By"
      datatype: "Text"
      length: 250
    - id: createdAt
      name: "Created At"
      datatype: "DateTime"
    - id: updatedAt
      name: "Updated At"
      datatype: "DateTime"
    - id: deletedAt
      name: "Deleted At"
      datatype: "DateTime"
  identifiers:
    - id: collectionsPrimaryKey
      name: "Collections Primary Key"
      primary: true
      attributes:
        - ^id