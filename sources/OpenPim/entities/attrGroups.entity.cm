entity:
  id: ^attrGroups
  name: "Attribute Groups"
  description: "Groups for organizing attributes"
  attributes:
    - id: ^identifier
      name: "Identifier"
      datatype: "Text"
      length: 250
    - id: ^name
      name: "Name"
      datatype: "Text"
    - id: order
      name: "Order"
      datatype: "Integer"
    - id: visible
      name: "Visible"
      datatype: "Boolean"
    - id: ^id
      name: "ID"
      datatype: "Integer"
    - id: tenantId
      name: "Tenant ID"
      datatype: "Text"
      length: 50
    - id: createdBy
      name: "Created By"
      datatype: "Text"
      length: 250
    - id: updatedBy
      name: "Updated By"
      datatype: "Text"
      length: 250
    - id: createdAt
      name: "Created At"
      datatype: "DateTime"
    - id: updatedAt
      name: "Updated At"
      datatype: "DateTime"
    - id: deletedAt
      name: "Deleted At"
      datatype: "DateTime"
    - id: options
      name: "Options"
      datatype: "Text"
  identifiers:
    - id: attrGroupsPrimaryKey
      name: "Attribute Groups Primary Key"
      primary: true
      attributes:
        - ^id