systemDiagram:
    id: business-diagram
    nodes:
      - id: SalesPersonNode
        entity: SalesPerson
        x: -10
        y: 230
        width: 200
        height: 150
      - id: CustomerNode
        entity: Customer
        x: 400
        y: 100
        width: 200
        height: 155.23072338104248
      - id: InvoiceNode
        entity: Invoice
        x: 230
        y: 320
        width: 200
        height: 195.01093006134033
      - id: CustomerRevenueNode
        entity: CustomerRevenue
        x: 320
        y: 560
        width: 200
        height: 150
    edges:
      - id: SalesPersonCustomerEdge_SalesPersonNode_CustomerNode
        relationship: business-layer.SalesPersonCustomer
        sourceNode: SalesPersonNode
        targetNode: CustomerNode
      - id: SalesPersonInvoiceEdge_SalesPersonNode_InvoiceNode
        relationship: business-layer.SalesPersonInvoice
        sourceNode: SalesPersonNode
        targetNode: InvoiceNode
      - id: CustomerInvoiceEdge_CustomerNode_InvoiceNode
        relationship: business-layer.CustomerInvoice
        sourceNode: CustomerNode
        targetNode: InvoiceNode
      - id: CustomerCustomerRevenueEdge
        relationship: business-layer.CustomerCustomerRevenue
        sourceNode: CustomerNode
        targetNode: CustomerRevenueNode
      - id: SalesPersonCustomerRevenueEdge
        relationship: business-layer.SalesPersonCustomerRevenue
        sourceNode: SalesPersonNode
        targetNode: CustomerRevenueNode