mapping:
    id: RevenuePerCustomer_mapping
    sources:
      - id: BIZ_Customer_Source
        entity: Customer
        join: from
      - id: BIZ_SalesPerson_Source
        entity: SalesPerson
        join: left-join
        dependencies:
          - BIZ_Customer_Source
        conditions:
          - BIZ_Customer_Source.SalesPersonId = BIZ_SalesPerson_Source.SalesPersonId
      - id: BIZ_Invoice_Source
        entity: Invoice
        join: left-join
        dependencies:
          - BIZ_Customer_Source
        conditions:
          - BIZ_Customer_Source.CustomerId = BIZ_Invoice_Source.CustomerId
    target:
        entity: RevenuePerCustomer
        mappings:
          - attribute: CustomerId
            sources:
              - BIZ_Customer_Source.CustomerId
          - attribute: CompanyName
            sources:
              - BIZ_Customer_Source.CompanyName
          - attribute: Industry
            sources:
              - BIZ_Customer_Source.Industry
          - attribute: SalesPersonId
            sources:
              - BIZ_SalesPerson_Source.SalesPersonId
          - attribute: SalesPersonName
            sources:
              - BIZ_SalesPerson_Source.FullName
          - attribute: SalesRegion
            sources:
              - BIZ_SalesPerson_Source.Region
          - attribute: TotalInvoiced
            sources:
              - BIZ_Invoice_Source.TotalAmount
            expressions:
              - language: "SQL"
                expression: "SUM({{BIZ_Invoice_Source.TotalAmount}})"
          - attribute: TotalPaid
            sources:
              - BIZ_Invoice_Source.TotalAmount
              - BIZ_Invoice_Source.Status
            expressions:
              - language: "SQL"
                expression: "SUM(CASE WHEN {{BIZ_Invoice_Source.Status}} = 'Paid' THEN {{BIZ_Invoice_Source.TotalAmount}} ELSE 0 END)"
          - attribute: TotalOutstanding
            sources:
              - BIZ_Invoice_Source.TotalAmount
              - BIZ_Invoice_Source.Status
            expressions:
              - language: "SQL"
                expression: "SUM(CASE WHEN {{BIZ_Invoice_Source.Status}} IN ('Sent', 'Overdue') THEN {{BIZ_Invoice_Source.TotalAmount}} ELSE 0 END)"
          - attribute: InvoiceCount
            sources:
              - BIZ_Invoice_Source.InvoiceId
            expressions:
              - language: "SQL"
                expression: "COUNT({{BIZ_Invoice_Source.InvoiceId}})"
          - attribute: OverdueCount
            sources:
              - BIZ_Invoice_Source.InvoiceId
              - BIZ_Invoice_Source.Status
            expressions:
              - language: "SQL"
                expression: "COUNT(CASE WHEN {{BIZ_Invoice_Source.Status}} = 'Overdue' THEN {{BIZ_Invoice_Source.InvoiceId}} END)"