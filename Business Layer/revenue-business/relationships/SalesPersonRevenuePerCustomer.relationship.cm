relationship:
  id: SalesPersonRevenuePerCustomer
  name: "Sales Person Revenue Per Customer"
  description: "Links a sales person to the revenue summaries of their customers"
  parent: SalesPerson
  parentRole: "sales person"
  parentCardinality: 1..1
  child: RevenuePerCustomer
  childRole: "customer revenue summaries"
  childCardinality: 0..N
  attributes:
  - parent: SalesPerson.SalesPersonId
    child: RevenuePerCustomer.SalesPersonId
