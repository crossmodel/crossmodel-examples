relationship:
  id: CustomerRevenuePerCustomer
  name: "Customer Revenue Per Customer"
  description: "Links a customer to their revenue summary"
  parent: Customer
  parentRole: "customer"
  parentCardinality: 1..1
  child: RevenuePerCustomer
  childRole: "revenue summary"
  childCardinality: 0..1
  attributes:
  - parent: Customer.CustomerId
    child: RevenuePerCustomer.CustomerId
