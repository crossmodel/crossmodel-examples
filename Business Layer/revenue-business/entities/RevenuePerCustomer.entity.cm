entity:
  id: RevenuePerCustomer
  name: "Revenue Per Customer"
  description: "Aggregated revenue view per customer, showing total invoiced, paid and outstanding amounts alongside the managing sales person"
  attributes:
  - id: CustomerId
    name: "Customer Id"
    description: "Unique customer identifier"
    datatype: "Integer"
    mandatory: true
  - id: CompanyName
    name: "Company Name"
    description: "Customer company name"
    datatype: "Text"
    length: 200
  - id: Industry
    name: "Industry"
    description: "Industry vertical of the customer"
    datatype: "Text"
    length: 50
  - id: SalesPersonId
    name: "Sales Person Id"
    description: "FK to the Sales Person managing this customer"
    datatype: "Integer"
  - id: SalesPersonName
    name: "Sales Person Name"
    description: "Full name of the managing sales person"
    datatype: "Text"
    length: 160
  - id: SalesRegion
    name: "Sales Region"
    description: "Sales region of the managing sales person"
    datatype: "Text"
    length: 30
  - id: TotalInvoiced
    name: "Total Invoiced"
    description: "Sum of all invoice amounts for this customer"
    datatype: "Decimal"
    precision: 14
    scale: 2
  - id: TotalPaid
    name: "Total Paid"
    description: "Sum of all paid invoice amounts"
    datatype: "Decimal"
    precision: 14
    scale: 2
  - id: TotalOutstanding
    name: "Total Outstanding"
    description: "Sum of all unpaid (Sent + Overdue) invoice amounts"
    datatype: "Decimal"
    precision: 14
    scale: 2
  - id: InvoiceCount
    name: "Invoice Count"
    description: "Total number of invoices for this customer"
    datatype: "Integer"
  - id: OverdueCount
    name: "Overdue Count"
    description: "Number of overdue invoices"
    datatype: "Integer"
  identifiers:
  - id: RevenuePerCustomerPK
    name: "Revenue Per Customer PK"
    primary: true
    attributes:
    - CustomerId
