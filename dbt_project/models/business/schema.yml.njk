{#
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  CrossGenerate Nunjucks template — dbt schema.yml                       ║
  ║                                                                          ║
  ║  Generates a SINGLE schema.yml covering all business-layer models.       ║
  ║  Generation level : MODEL                                                ║
  ║  Crossgenerate output filename: schema.yml  (single-file output)         ║
  ╚══════════════════════════════════════════════════════════════════════════╝

  CrossModel variable reference (model level)
  ─────────────────────────────────────────────
  model                             the data model being generated
    model.id                        data model identifier
    model.mappings[]                all mapping files in the data model
  mapping.target.entity             the business-layer target entity
    entity.id                       entity identifier  (= dbt model name)
    entity.name                     human-readable name
    entity.description              entity description
    entity.datamodel.id             data model id of the target entity
    entity.attributes[]             list of attributes
      attribute.id                  attribute identifier  (= dbt column name)
      attribute.description         column description
      attribute.mandatory           true → emit "not_null" test
    entity.identifiers[]            list of identifiers
      identifier.primary            true → its attributes get a "unique" test
      identifier.attributes[]       list of attribute id strings
  mapping.sources[]                 source objects
    source.entity.datamodel.id      data model id of the source entity

  Column test rules
  ──────────────────
  • not_null  → attribute.mandatory == true
  • unique    → attribute.id is listed in a primary identifier
#}
version: 2

models:
{% for mapping in model.mappings %}
{% set entity = mapping.target.entity %}

{# ── Build the set of attribute ids that belong to the primary identifier ── #}
{% set pkAttrIds = [] %}
{% for identifier in entity.identifiers %}
  {% if identifier.primary %}
    {% for attrRef in identifier.attributes %}
      {% if attrRef not in pkAttrIds %}
        {% set _ = pkAttrIds.push(attrRef) %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}

{# ── Partition sources into external (different data model) and internal ─── #}
{% set externalSources = [] %}
{% set internalSources = [] %}
{% for source in mapping.sources %}
  {% if source.entity.datamodel.id != entity.datamodel.id %}
    {% set _ = externalSources.push(source) %}
  {% else %}
    {% set _ = internalSources.push(source) %}
  {% endif %}
{% endfor %}

  - name: {{ entity.id | lower }}
    description: >
      {{ entity.description }}.
{% if externalSources | length > 0 %}
      Built from {% for src in externalSources %}{{ src.entity.datamodel.id | replace("-", "_") }}.{{ src.entity.id }}{% if not loop.last %}, {% endif %}{% endfor %}.
{% elif internalSources | length > 0 %}
      References the business layer models: {% for src in internalSources %}{{ src.entity.id | lower }}{% if not loop.last %}, {% endif %}{% endfor %}.
{% endif %}
    columns:
{% for attribute in entity.attributes %}
{% set attrId       = attribute.id %}
{% set isInPK       = attrId in pkAttrIds %}
{% set hasMandatory = attribute.mandatory %}
      - name: {{ attrId }}
        description: "{{ attribute.description }}"
{% if isInPK or hasMandatory %}
        tests:
{% if hasMandatory %}
          - not_null
{% endif %}
{% if isInPK %}
          - unique
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
