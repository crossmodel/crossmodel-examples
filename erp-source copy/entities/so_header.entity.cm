entity:
  id: so_header
  name: "SO_HEADER"
  description: "Sales order header"
  attributes:
  - id: so_id
    name: "SO_ID"
    description: "Sales order identifier"
    datatype: "Integer"
    mandatory: true
  - id: cust_num
    name: "CUST_NUM"
    description: "Customer number (external ref)"
    datatype: "Integer"
    mandatory: true
  - id: order_dt
    name: "ORDER_DT"
    description: "Order date/time"
    datatype: "DateTime"
  - id: stat_cd
    name: "STAT_CD"
    description: "Status code (PND, SHP, DLV, CAN)"
    datatype: "Text"
    length: 5
  - id: tot_amt
    name: "TOT_AMT"
    description: "Order total amount"
    datatype: "Decimal"
    precision: 12
    scale: 2
  - id: ccy_cd
    name: "CCY_CD"
    description: "Currency code (ISO 4217)"
    datatype: "Text"
    length: 3
  identifiers:
  - id: pk_so_header
    name: "PK_SO_HEADER"
    primary: true
    attributes:
    - so_id
