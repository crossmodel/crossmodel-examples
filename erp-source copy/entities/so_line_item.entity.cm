entity:
  id: so_line_item
  name: "SO_LINE_ITEM"
  description: "Sales order line items"
  attributes:
  - id: line_id
    name: "LINE_ID"
    description: "Line item surrogate key"
    datatype: "Integer"
    mandatory: true
  - id: so_id
    name: "SO_ID"
    description: "FK to SO_HEADER"
    datatype: "Integer"
    mandatory: true
  - id: item_id
    name: "ITEM_ID"
    description: "FK to INV_ITEM_MASTER"
    datatype: "Integer"
    mandatory: true
  - id: qty
    name: "QTY"
    description: "Quantity ordered"
    datatype: "Integer"
    mandatory: true
  - id: unit_prc
    name: "UNIT_PRC"
    description: "Price per unit at time of sale"
    datatype: "Decimal"
    precision: 10
    scale: 2
  - id: line_amt
    name: "LINE_AMT"
    description: "Line total amount"
    datatype: "Decimal"
    precision: 12
    scale: 2
  identifiers:
  - id: pk_so_line_item
    name: "PK_SO_LINE_ITEM"
    primary: true
    attributes:
    - line_id
