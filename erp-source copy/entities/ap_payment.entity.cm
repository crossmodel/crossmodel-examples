entity:
  id: ap_payment
  name: "AP_PAYMENT"
  description: "Accounts payable / payment transactions"
  attributes:
  - id: pmt_id
    name: "PMT_ID"
    description: "Payment surrogate key"
    datatype: "Integer"
    mandatory: true
  - id: so_id
    name: "SO_ID"
    description: "FK to SO_HEADER"
    datatype: "Integer"
    mandatory: true
  - id: pmt_method
    name: "PMT_METHOD"
    description: "Payment method (CC, PP, BT, COD)"
    datatype: "Text"
    length: 10
  - id: pmt_dt
    name: "PMT_DT"
    description: "Payment timestamp"
    datatype: "DateTime"
  - id: pmt_amt
    name: "PMT_AMT"
    description: "Payment amount"
    datatype: "Decimal"
    precision: 12
    scale: 2
  - id: pmt_stat
    name: "PMT_STAT"
    description: "Payment status (PND, OK, REF, FAIL)"
    datatype: "Text"
    length: 5
  identifiers:
  - id: pk_ap_payment
    name: "PK_AP_PAYMENT"
    primary: true
    attributes:
    - pmt_id
