mapping:
    id: MappingFromSimpleSales
    sources:
      - id: CustomerSourceObject
        entity: MySimpleSalesSystem.Customer
        join: from
    target:
        entity: Customer
        mappings:
          - attribute: CustomerID
            sources:
              - CustomerSourceObject.CustomerID
          - attribute: CustomerName
            sources:
              - CustomerSourceObject.CustomerName
          - attribute: DateOfBirth
            sources:
              - CustomerSourceObject.DateOfBirth
          - attribute: YearOfBirth
            sources:
              - CustomerSourceObject.DateOfBirth
            expression: "YEAR({{CustomerSourceObject.DateOfBirth}}"
          - attribute: CustomerIdentifier
            sources:
              - CustomerSourceObject.CustomerID
              - CustomerSourceObject.CustomerName
            expression: "CONCAT_WS({{CustomerSourceObject.CustomerID}},{{CustomerSourceObject.CustomerName}})"