{{!-- Create view to implement mapping --}}
CREATE OR REPLACE VIEW vw_{{mapping.id}} AS
SELECT
{{#each mapping.target.mappings}}
	{{#if expressions}}{{#each expressions}}{{{expression}}}{{/each}}{{else}}{{#each sources}}{{value.$refText}}{{/each}}{{/if}} AS {{attribute.value.id}}{{#unless @last}},{{/unless}}
{{/each}}
{{#each mapping.sources}}
{{join}} {{entity._globalId}} AS {{id}}
	{{#each conditions}}
	{{#if @first}} ON {{else}}AND {{/if}}{{expression.left.value.$refText}} {{{expression.op}}} {{expression.right.value.$refText}}
	{{/each}}
{{/each}}