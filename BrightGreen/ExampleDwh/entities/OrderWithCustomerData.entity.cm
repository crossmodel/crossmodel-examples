entity:
    id: OrderWithCustomerData
    name: "OrderWithCustomerData"
    description: "Denormalized view of a sales order enriched with customer information"
    attributes:
      - id: SalesOrderID
        name: "SalesOrderID"
        description: "Unique identifier for the sales order"
        datatype: "Integer"
      - id: Orderdate
        name: "Orderdate"
        description: "Date when the order was placed"
        datatype: "Date"
      - id: CustomerName
        name: "CustomerName"
        description: "Full name of the customer who placed the order"
        datatype: "Text"
        length: 250
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - SalesOrderID