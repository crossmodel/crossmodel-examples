entity:
    id: CustomerWithOrderCount
    name: "CustomerWithOrderCount"
    attributes:
      - id: Customer_ID
        name: "Customer ID"
        datatype: "Text"
      - id: OrderCount
        name: "OrderCount"
        datatype: "Integer"
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - Customer_ID