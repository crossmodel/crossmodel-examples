entity:
    id: Product
    name: "Product"
    description: "Represents a product available for sale"
    type: dwh-definitions.HistoricalEntity
    attributes:
      - id: ^id
        name: "Id"
        description: "Surrogate key for Product"
        datatype: "Integer"
        mandatory: true
      - id: Name
        name: "Name"
        description: "Product name"
        datatype: "Text"
        length: 100
        mandatory: true
      - id: Description
        name: "Description"
        description: "Product description"
        datatype: "Text"
        length: 200
      - id: UnitPrice
        name: "Unit Price"
        description: "Unit price of the product"
        datatype: "Decimal"
        precision: 10
        scale: 2
        mandatory: true
      - id: Category
        name: "Category"
        description: "Product category"
        datatype: "Text"
        length: 50
      - id: WarehouseId
        name: "Warehouse Id"
        description: "Reference to Warehouse"
        datatype: "Integer"
        mandatory: true
    identifiers:
      - id: ProductPrimaryKey
        name: "Product Primary Key"
        primary: true
        attributes:
          - ^id