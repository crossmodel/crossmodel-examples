entity:
    id: CustomerFullName
    name: "CustomerFullName"
    description: "Customer with Full Name"
    attributes:
      - id: CustomerID
        name: "CustomerID"
        datatype: "Text"
      - id: FullName
        name: "FullName"
        datatype: "Text"
        mandatory: true
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - CustomerID