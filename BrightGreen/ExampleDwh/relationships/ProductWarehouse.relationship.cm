relationship:
  id: ProductWarehouse
  name: "Product Warehouse"
  description: "Links products to their warehouse"
  parent: Warehouse
  parentRole: "warehouse"
  parentCardinality: 1..1
  child: Product
  childRole: "products"
  childCardinality: 0..N
  attributes:
  - parent: Warehouse.^id
    child: Product.WarehouseId