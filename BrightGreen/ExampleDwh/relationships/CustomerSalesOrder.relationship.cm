relationship:
  id: CustomerSalesOrder
  name: "Customer Sales Order"
  description: "Links a customer to their sales orders"
  parent: Customer
  parentRole: "customer"
  parentCardinality: 1..1
  child: SalesOrder
  childRole: "Sales Orders"
  childCardinality: 0..N
  attributes:
  - parent: Customer.^id
    child: SalesOrder.CustomerId