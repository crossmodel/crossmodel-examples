mapping:
  id: SalesOrderLine_JuiceERP
  sources:
  - id: SalesOrderLineSource
    entity: JuiceERP.SalesOrderLine
    join: from
  target:
    entity: SalesOrderLine
    mappings:
    - attribute: ^id
      sources:
        - SalesOrderLineSource.SalesOrderID
    - attribute: SalesOrderId
      sources:
        - SalesOrderLineSource.SalesOrderID
    - attribute: ProductId
      sources:
        - SalesOrderLineSource.ProductID
    - attribute: Quantity
      sources:
        - SalesOrderLineSource.Quantity
    - attribute: UnitPrice
      sources:
        - SalesOrderLineSource.ItemPrice
    - attribute: LineTotal
      sources:
        - SalesOrderLineSource.Quantity
        - SalesOrderLineSource.ItemPrice
      expressions:
      - language: "SQL"
        expression: "{{SalesOrderLineSource.Quantity}} * {{SalesOrderLineSource.ItemPrice}}"