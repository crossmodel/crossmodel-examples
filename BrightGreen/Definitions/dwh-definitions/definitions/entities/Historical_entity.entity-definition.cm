entityDefinition:
    id: Historical_entity
    name: "Historical entity"
    extends: Formal_entity
    attributes:
      - id: Functional_begin_date
        name: "Functional_begin_date"
        datatype: "DateTime"
        mandatory: true
      - id: Functional_end_date
        name: "Functional_end_date"
        datatype: "DateTime"
    customProperties:
      - id: Materialize
        name: "Materialize"
        value: "True"