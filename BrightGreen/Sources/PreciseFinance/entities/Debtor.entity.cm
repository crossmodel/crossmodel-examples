entity:
    id: DEBTOR
    name: "Debtor"
    attributes:
      - id: DEBTORID
        name: "DebtorId"
        datatype: "Integer"
      - id: NAME
        name: "Name"
        datatype: "Text"
      - id: IBAN
        name: "IBAN"
        datatype: "Text"
      - id: JUICEERPCUSTOMERID
        name: "JuiceERP_CustomerID"
        datatype: "Integer"
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - DEBTORID