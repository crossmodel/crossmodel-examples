relationship:
  id: SupplierPurchaseOrder
  name: "Supplier Purchase Order"
  description: "Links a supplier to their purchase orders"
  parent: Supplier
  parentRole: "supplier"
  parentCardinality: 1..1
  child: PurchaseOrder
  childRole: "purchase orders"
  childCardinality: 0..N
  attributes:
  - parent: Supplier.^id
    child: PurchaseOrder.SupplierId