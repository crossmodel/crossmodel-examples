entity:
  id: PurchaseOrder
  name: "Purchase Order"
  description: "Represents a purchase order in the OptimalERP system"
  attributes:
  - id: ^id
    name: "PurchaseOrderId"
    description: "Surrogate key for Purchase Order"
    datatype: "Integer"
    mandatory: true
  - id: OrderNumber
    name: "Order Number"
    description: "Purchase order reference number"
    datatype: "Text"
    length: 20
    mandatory: true
  - id: OrderDate
    name: "Order Date"
    description: "Date when purchase order was placed"
    datatype: "Date"
    mandatory: true
  - id: SupplierId
    name: "SupplierId"
    description: "Foreign key to Supplier"
    datatype: "Integer"
    mandatory: true
  - id: TotalAmount
    name: "Total Amount"
    description: "Total purchase order amount"
    datatype: "Decimal"
    precision: 10
    scale: 2
    mandatory: true
  - id: Status
    name: "Status"
    description: "Purchase order status"
    datatype: "Text"
    length: 20
    mandatory: true
  identifiers:
  - id: PurchaseOrderPrimaryKey
    name: "Purchase Order Primary Key"
    primary: true
    attributes:
    - ^id