entity:
  id: Warehouse
  name: "Warehouse"
  description: "Represents a warehouse in the OptimalERP system"
  attributes:
  - id: ^id
    name: "WarehouseId"
    description: "Surrogate key for Warehouse"
    datatype: "Integer"
    mandatory: true
  - id: Name
    name: "Name"
    description: "Warehouse name"
    datatype: "Text"
    length: 100
    mandatory: true
  - id: Location
    name: "Location"
    description: "Warehouse location"
    datatype: "Text"
    length: 200
  identifiers:
  - id: WarehousePrimaryKey
    name: "Warehouse Primary Key"
    primary: true
    attributes:
    - ^id