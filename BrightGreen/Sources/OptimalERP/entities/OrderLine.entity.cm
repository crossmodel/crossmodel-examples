entity:
  id: OrderLine
  name: "Order Line"
  description: "Represents a line item in a sales order"
  attributes:
  - id: ^id
    name: "OrderLineId"
    description: "Surrogate key for Order Line"
    datatype: "Integer"
    mandatory: true
  - id: OrderId
    name: "OrderId"
    description: "Foreign key to Sales Order"
    datatype: "Integer"
    mandatory: true
  - id: ProductId
    name: "ProductId"
    description: "Foreign key to Product"
    datatype: "Integer"
    mandatory: true
  - id: Quantity
    name: "Quantity"
    description: "Quantity ordered"
    datatype: "Integer"
    mandatory: true
  - id: UnitPrice
    name: "Unit Price"
    description: "Unit price at time of order"
    datatype: "Decimal"
    precision: 10
    scale: 2
    mandatory: true
  - id: LineTotal
    name: "Line Total"
    description: "Total amount for this line"
    datatype: "Decimal"
    precision: 10
    scale: 2
    mandatory: true
  identifiers:
  - id: OrderLinePrimaryKey
    name: "Order Line Primary Key"
    primary: true
    attributes:
    - ^id