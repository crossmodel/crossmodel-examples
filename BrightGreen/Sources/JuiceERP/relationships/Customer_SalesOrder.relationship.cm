relationship:
   id: Customer_SalesOrder
   name: "Customer_SalesOrder"
   description: "Links a customer to their sales orders, indicating which customer placed each order"
   parent: Customer
   parentCardinality: 0..1
   child: SalesOrder   
   childCardinality: 0..N
   attributes:
      - parent: Customer.CustomerID
        child: SalesOrder.CustomerID