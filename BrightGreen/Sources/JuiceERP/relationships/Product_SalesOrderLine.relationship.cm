relationship:
   id: Product_SalesOrderLine
   name: "Product_SalesOrderLine"
   description: "Links a product to the sales order lines in which it was ordered"
   parent: Product
   parentCardinality: 0..1
   child: SalesOrderLine   
   childCardinality: 0..N
   attributes:
      - parent: Product.ProductID
        child: SalesOrderLine.ProductID