entity:
    id: SalesOrderLine
    name: "SalesOrderLine"
    description: "Represents an individual line item within a sales order"
    attributes:
      - id: SalesOrderID
        name: "SalesOrderID"
        description: "Reference to the parent sales order"
        datatype: "Integer"
      - id: ProductID
        name: "ProductID"
        description: "Reference to the product on this order line"
        datatype: "Integer"
      - id: ItemPrice
        name: "ItemPrice"
        description: "Price per unit of the product at the time of the order"
        datatype: "Decimal"
      - id: Quantity
        name: "Quantity"
        description: "Number of units ordered for this line item"
        datatype: "Integer"
      - id: LineAmt
        name: "LineAmt"
        description: "Total amount for this order line (ItemPrice multiplied by Quantity)"
        datatype: "Decimal"
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - SalesOrderID