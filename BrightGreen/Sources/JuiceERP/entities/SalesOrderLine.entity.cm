entity:
    id: SalesOrderLine
    name: "SalesOrderLine"
    attributes:
      - id: SalesOrderID
        name: "SalesOrderID"
        datatype: "Integer"
      - id: ProductID
        name: "ProductID"
        datatype: "Integer"
      - id: ItemPrice
        name: "ItemPrice"
        datatype: "Decimal"
      - id: Quantity
        name: "Quantity"
        datatype: "Integer"
      - id: LineAmt
        name: "LineAmt"
        datatype: "Decimal"
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - SalesOrderID