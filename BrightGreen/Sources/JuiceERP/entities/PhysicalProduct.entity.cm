entity:
    id: PhysicalProduct
    name: "PhysicalProduct"
    description: "A physical product with dimensional and weight attributes, inheriting base product attributes"
    inherits:
      - Product
    attributes:
      - id: ProductID
        name: "ProductID"
        description: "Unique identifier for the product"
        datatype: "Integer"
      - id: EANCode
        name: "EANCode"
        description: "European Article Number barcode for the product"
        datatype: "Text"
      - id: Description
        name: "Description"
        description: "Textual description of the product"
        datatype: "Text"
      - id: ItemPrice
        name: "ItemPrice"
        description: "Unit price of the product"
        datatype: "Decimal"
      - id: WidthInCm
        name: "WidthInCm"
        description: "Width of the product in centimeters"
        datatype: "Integer"
      - id: LengthInCm
        name: "LengthInCm"
        description: "Length of the product in centimeters"
        datatype: "Integer"
      - id: HeightInCm
        name: "HeightInCm"
        description: "Height of the product in centimeters"
        datatype: "Integer"
      - id: WeightInKG
        name: "WeightInKG"
        description: "Weight of the product in kilograms"
        datatype: "Decimal"
    identifiers:
      - id: Primary_Identifier
        name: "Primary Identifier"
        primary: true
        attributes:
          - ProductID